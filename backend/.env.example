# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/querylens

# AI Providers
# Default is Ollama (local, no API key required).
# Docker Compose overrides OLLAMA_BASE_URL to http://ollama:11434 automatically.
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Optional: set to switch to a cloud provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# CORS
CORS_ORIGINS=["http://localhost:3000"]
